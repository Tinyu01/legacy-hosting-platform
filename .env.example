# ============================================================
# Legacy Hosting Platform — Environment Template
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Storefront
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000
API_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://legacy:legacy@localhost:5432/legacy_hosting

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# FOSSBilling (headless)
FOSSBILLING_URL=https://billing.example.com
FOSSBILLING_API_TOKEN=

# Registrar adapters (never commit real tokens)
NAMECOM_API_USERNAME=
NAMECOM_API_TOKEN=

# Cloud providers
HETZNER_API_TOKEN=
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# Hosting providers
HOSTAFRICA_API_CREDENTIALS=
AFRICANHOST_API_CREDENTIALS=

# Payment gateways
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
YOCO_SECRET_KEY=

# Feature flags
FEATURE_DOMAIN_SEARCH=true
FEATURE_VPS_PROVISIONING=false
FEATURE_MANAGED_VPS=false
