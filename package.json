{
  "name": "legacy-hosting-platform",
  "version": "2026.1.0",
  "private": true,
  "description": "Legacy Hosting Platform monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @legacy-hosting/storefront dev",
    "dev:storefront": "pnpm --filter @legacy-hosting/storefront dev",
    "dev:api": "pnpm --filter @legacy-hosting/api dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0"
  }
}
