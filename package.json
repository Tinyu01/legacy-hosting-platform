{
  "name": "legacy-hosting",
  "private": true,
  "version": "2026.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate:catalog": "ts-node scripts/validate-catalog.ts",
    "smoke": "ts-node scripts/smoke-test.ts",
    "api": "npm run dev --workspace=@legacy-hosting/api",
    "storefront": "npm run dev --workspace=@legacy-hosting/storefront",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.14.10"
  }
}
